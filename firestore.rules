rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── users ─────────────────────────────────────────────────────────────────
    // Only server (Admin SDK) should write; lock down client writes
    match /users/{userId} {
      allow read, write: if false;
    }

    // ── printJobs ─────────────────────────────────────────────────────────────
    match /printJobs/{jobId} {
      allow read, write: if false;
    }

    // ── notifications ─────────────────────────────────────────────────────────
    // Client-side Firestore access is completely disabled. All reads & writes run via Admin SDK.
    match /notifications/{notifId} {
      allow read, write: if false;
    }

    // ── everything else ───────────────────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
